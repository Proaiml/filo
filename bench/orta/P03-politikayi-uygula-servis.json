      "komut": {
        "debian": "DEBIAN_FRONTEND=noninteractive apt-get install -y -q jq tree >/dev/null 2>&1; printf '%s\\n' 'Bu sunucu Filo ile teslim edilmistir. Yetkisiz erisim yasaktir.' > /etc/motd; /usr/local/sbin/filo-svc start uygulama",
        "rhel": "dnf -y -q install jq tree >/dev/null 2>&1; printf '%s\\n' 'Bu sunucu Filo ile teslim edilmistir. Yetkisiz erisim yasaktir.' > /etc/motd; /usr/local/sbin/filo-svc start uygulama",
